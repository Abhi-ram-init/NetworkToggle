<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exclusive Signature-Level Permission: No other app can obtain or access this permission -->
    <permission
        android:name="com.example.networktoggle.permission.CONTROL_NETWORK_TOGGLE"
        android:protectionLevel="signature"
        android:label="@string/perm_label"
        android:description="@string/perm_description" />

    <uses-permission android:name="com.example.networktoggle.permission.CONTROL_NETWORK_TOGGLE" />

    <!-- Standard and Privileged Permissions -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetworkToggle">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Shortcuts (long-press launcher icon) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Option 1: 2x1 Standard Pill Widget -->
        <receiver
            android:name=".widget.NetworkToggleWidget"
            android:exported="true"
            android:permission="com.example.networktoggle.permission.CONTROL_NETWORK_TOGGLE">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.networktoggle.ACTION_TOGGLE_NETWORK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/network_toggle_widget_info" />
        </receiver>

        <!-- Option 2: 1x1 Compact Quick-Toggle Widget -->
        <receiver
            android:name=".widget.CompactToggleWidget"
            android:exported="true"
            android:permission="com.example.networktoggle.permission.CONTROL_NETWORK_TOGGLE">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.networktoggle.ACTION_TOGGLE_COMPACT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compact_widget_info" />
        </receiver>

        <!-- Option 3: 4x2 Multi-Option Dashboard Widget -->
        <receiver
            android:name=".widget.DashboardToggleWidget"
            android:exported="true"
            android:permission="com.example.networktoggle.permission.CONTROL_NETWORK_TOGGLE">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.networktoggle.ACTION_DASH_5G" />
                <action android:name="com.example.networktoggle.ACTION_DASH_AUTO" />
                <action android:name="com.example.networktoggle.ACTION_DASH_4G" />
                <action android:name="com.example.networktoggle.ACTION_DASH_FORCE_MENU" />
                <action android:name="com.example.networktoggle.ACTION_DASH_SETTINGS" />
                <action android:name="com.example.networktoggle.ACTION_DASH_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dashboard_widget_info" />
        </receiver>

        <!-- Quick Settings Tile 1: Network Mode Toggle -->
        <service
            android:name=".tile.NetworkToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_network_5g"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tile 2: Macro Optimizer Tile (Control Panel Widget) -->
        <service
            android:name=".tile.NetworkMacroTileService"
            android:exported="true"
            android:icon="@drawable/ic_macro_tile"
            android:label="@string/macro_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
